# Frontend env. Copy to .env.local for local dev.

# Embedded-mode Worker base URL. When set, the frontend posts to
# ${VITE_API_BASE}/api/extract instead of calling LLMs directly.
# Leave unset for BYOK / dev mode.
# Example: VITE_API_BASE=https://offerlens-api.your-account.workers.dev
VITE_API_BASE=

# Cloudflare Turnstile site key (public). Required when VITE_API_BASE is
# set — the Worker rejects requests without a valid Turnstile token.
# Get one at https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=
